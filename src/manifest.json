{
  "author": "Craig Walker",
  "manifest_version": 3,
  "name": "Baby Mode",
  "description": "Happy Baby, Happy Browsing",
  "version": "1.4",
  "minimum_chrome_version": "109",
  "offline_enabled": true,
  "action": {
    "default_icon": "48.png",
    "default_popup": "popup.html",
    "default_title": "Baby Mode"
  },
  "icons": {
    "16": "16.png",
    "48": "48.png",
    "128": "128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "commands": {
    "toggle-baby-mode": {
      "suggested_key": {
        "mac": "Command+Shift+0",
        "windows": "Ctrl+Shift+0"
      },
      "description": "Toggle baby mode",
      "global": true
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["48.png", "sounds/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": ["storage", "offscreen", "commands"],
  "host_permissions": ["<all_urls>"]
}
